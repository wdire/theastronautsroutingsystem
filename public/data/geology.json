{"units":[{"code":"eNh","name":"Early Noachian highland unit","colour":"#b9875f","kind":"highland","what":"The oldest highland crust, broken up by giant impacts in Mars's first few hundred million years.","period":"Early Noachian","age":"more than 3.9 billion years old","ageMaxGa":4.1,"ageMinGa":3.94},{"code":"mNh","name":"Middle Noachian highland unit","colour":"#cd9d81","kind":"highland","what":"Ancient cratered highland: a mix of impact rubble, old lava and sediment.","period":"Middle Noachian","age":"about 3.8 to 3.9 billion years old","ageMaxGa":3.94,"ageMinGa":3.83},{"code":"mNhm","name":"Middle Noachian highland massif unit","colour":"#a0a498","kind":"highland","what":"Rugged highland mountains: blocks of old crust pushed up around a giant impact basin.","period":"Middle Noachian","age":"about 3.8 to 3.9 billion years old","ageMaxGa":3.94,"ageMinGa":3.83},{"code":"HNt","name":"Hesperian and Noachian transition unit","colour":"#fba61c","kind":"transition","what":"Old highland knobs and mesas with younger plains and slope deposits between them, where the highlands step down toward the lowlands.","period":"Noachian to Hesperian","age":"about 3.4 to 3.9 billion years old","ageMaxGa":3.94,"ageMinGa":3.37},{"code":"AHi","name":"Amazonian and Hesperian impact unit","colour":"#fff100","kind":"impact","what":"A younger impact crater with its rim and the blanket of rock thrown out around it.","period":"Hesperian to Amazonian","age":"less than about 3.7 billion years old","ageMaxGa":3.71,"ageMinGa":0.0},{"code":"eHv","name":"Early Hesperian volcanic unit","colour":"#b27ab5","kind":"volcanic","what":"Flood lavas: thin, runny basalt flows that spread out as wide, ridged plains.","period":"Early Hesperian","age":"about 3.6 to 3.7 billion years old","ageMaxGa":3.71,"ageMinGa":3.61},{"code":"lHt","name":"Late Hesperian transition unit","colour":"#ffcb06","kind":"transition","what":"Plains of sediment and lava laid down along the edge between highlands and lowlands.","period"