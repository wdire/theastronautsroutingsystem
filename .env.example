# NASA API key for the DONKI space weather feeds (https://api.nasa.gov). Optional: without it the
# function under api/ asks NASA's keyless server. Read only by api/spaceweather.ts; never sent to the browser.
# On Vercel, set it under Project Settings, Environment Variables.
NASA_API_KEY=

# Convex backend (crews, presence, the live mission feed). `npx convex dev` writes the real value to .env.local;
# without it the app runs solo. Locally it is http://127.0.0.1:3210.
# VITE_CONVEX_URL=
